                    href="mailto:hello@matteobacker.com"
                    className="font-geist font-medium text-[20px] sm:text-[24px] leading-[120%] text-[#01060A] transition-opacity hover:opacity-75"
                  >
                    hello@matteobacker.com
                  </a>
                </div>

                {/* Phone Number */}
                <div className="flex flex-col items-start sm:items-end gap-1">
                  <span className="font-geist font-normal text-[16px] sm:text-[18px] leading-[120%] text-[rgba(1,7,11,0.7)]">
                    /phone number
                  </span>
                  <a
                    href="tel:+8801515230435"
                    className="font-geist font-medium text-[20px] sm:text-[24px] leading-[120%] text-[#01060A] transition-opacity hover:opacity-75"
                  >
                    +880 (151) 523 - 0435
                  </a>
                </div>
              </div>
            </motion.div>
          </div>

          {/* ========================================================================= */}
          {/* 2. FOOTER BOTTOM CONTAINER (Nav & Socials, Responsive SVG Name, Copyright) */}
          {/* ========================================================================= */}
          <div className="w-full flex flex-col gap-[24px] mt-auto">
            {/* Top Bar: Nav Links (Left), Centered Social Icons (Middle), Back To Top (Right) */}
