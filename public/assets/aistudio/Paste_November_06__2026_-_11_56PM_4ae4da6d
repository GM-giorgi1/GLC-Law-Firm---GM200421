                  style={{
                    fontFamily: "'Big Shoulders Display', 'Big Shoulders', sans-serif",
                    fontWeight: 900,
                  }}
                >
                  Home
                </button>
                <button
                  type="button"
                  onClick={() => scrollToSection('about')}
                  className="font-big-shoulders font-[900] text-[20px] sm:text-[22px] md:text-[24px] lg:text-[32px] leading-[100%] uppercase text-[#01060A] hover:text-white transition-colors cursor-pointer"
                  style={{
                    fontFamily: "'Big Shoulders Display', 'Big Shoulders', sans-serif",
                    fontWeight: 900,
                  }}
                >
                  About
                </button>
                <button
                  type="button"
                  onClick={() => scrollToSection('services')}
                  className="font-big-shoulders font-[900] text-[20px] sm:text-[22px] md:text-[24px] lg:text-[32px] leading-[100%] uppercase text-[#01060A] hover:text-white transition-colors cursor-pointer"
                  style={{
                    fontFamily: "'Big Shoulders Display', 'Big Shoulders', sans-serif",
                    fontWeight: 900,
                  }}
                >
                  Services
                </button>
              </div>

              {/* Middle: 4 Social Buttons (Centered on Desktop & Tablet) */}
              <div className="flex items-center gap-2 sm:gap-2.5 lg:gap-3 sm:absolute sm:left-1/2 sm:-translate-x-1/2 sm:top-1/2 sm:-translate-y-1/2">
                {socialLinks.map((item) => (
                  <a
                    key={item.id}
                    href={item.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={item.name}
                    className="w-[26px] h-[26px] sm:w-[26px] sm:h-[26px] md:w-[28px] md:h-[28px] rounded-[6px] bg-[#01060A] border border-[rgba(1,7,11,0.1)] flex items-center justify-center transition-transform duration-200 hover:scale-115 hover:bg-[#191B1D]"
                    style={{ backgroundColor: '#01060A' }}
                  >
                    {item.icon}
                  </a>
                ))}
              </div>

              {/* Right: Back To Top Button (Reduced on tablet) */}
              <div>
                <button
                  type="button"
                  onClick={scrollToTop}
                  className="font-big-shoulders font-[900] text-[20px] sm:text-[22px] md:text-[24px] lg:text-[32px] leading-[100%] uppercase text-[#01060A] hover:text-white transition-colors cursor-pointer"
                  style={{
                    fontFamily: "'Big Shoulders Display', 'Big Shoulders', sans-serif",
                    fontWeight: 900,
                  }}
                >
                  BACK TO TOP
                </button>
              </div>
            </motion.div>

            {/* Middle Row: Full-Width Responsive SVG Name Typography */}
            <motion.div
              variants={itemFadeUp}
              className="w-full flex items-center justify-center overflow-hidden select-none"
            >
              {/* Desktop & Tablet SVG (100% full width scaling with continuous dark organic flame effect) */}
              <div
                className="hidden sm:flex w-full items-center justify-center"
                style={{
                  filter: 'url(#dark-organic-effect)',
                  willChange: 'filter',
                }}
              >
                <Image
                  src={BOTTOM_NAME_DESKTOP_SVG}
                  alt="MATTEO BACKER"
                  width={1472}
                  height={198}
                  className="w-full h-auto object-contain pointer-events-none"
                  referrerPolicy="no-referrer"
                  priority
                />
              </div>

              {/* Mobile SVG (Slightly reduced width & height for mobile screen with dark organic effect) */}
              <div
                className="flex sm:hidden w-full items-center justify-center px-2"
                style={{
                  filter: 'url(#dark-organic-effect)',
                  willChange: 'filter',
                }}
              >
                <Image
                  src={BOTTOM_NAME_MOBILE_SVG}
                  alt="MATTEO BACKER"
                  width={340}
                  height={190}
                  className="w-[88%] max-w-[320px] h-auto object-contain pointer-events-none"
                  referrerPolicy="no-referrer"
                  priority
                />
              </div>
            </motion.div>

            {/* Bottom Row: Copyright & Credits */}
            <motion.div
              variants={itemFadeUp}
              className="w-full flex flex-col sm:flex-row items-center justify-between gap-2"
            >
              {/* Left: Copyright */}
              <span className="font-geist font-medium text-[14px] sm:text-[16px] leading-[120%] text-[#01060A]">
                Copyright © Matteo Backer
              </span>

              {/* Right: Build by */}
              <span className="font-geist font-medium text-[14px] sm:text-[16px] leading-[120%] text-[#01060A]">
                Build by Jiro.build
              </span>
            </motion.div>
          </div>
        </motion.div>
      </ImageMouseTrail>
    </footer>
  );
}


