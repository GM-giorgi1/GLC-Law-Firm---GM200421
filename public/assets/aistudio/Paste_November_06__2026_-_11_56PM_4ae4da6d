              type="fractalNoise"
              baseFrequency="0.014 0.07"
              numOctaves="3"
              result="noise"
            >
              <animate
                attributeName="baseFrequency"
                values="0.012 0.05; 0.025 0.11; 0.016 0.08; 0.012 0.05"
                dur="4.5s"
                repeatCount="indefinite"
              />
            </feTurbulence>
            <feDisplacementMap
              in="SourceGraphic"
              in2="noise"
              scale="10"
              xChannelSelector="R"
              yChannelSelector="G"
            />
          </filter>
        </defs>
