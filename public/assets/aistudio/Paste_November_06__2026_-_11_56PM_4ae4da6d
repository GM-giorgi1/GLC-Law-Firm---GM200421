              animate={{
                opacity: 1,
                scale: 1,
                rotate: item.rotation,
                x: item.x - cardWidth / 2,
                y: item.y - cardHeight / 2,
                transition: {
                  type: 'spring',
                  stiffness: 420,
                  damping: 26,
                },
              }}
              exit={{
                opacity: 0,
                scale: 0.8,
                filter: 'blur(2px)',
                transition: { duration: 0.28, ease: 'easeOut' },
              }}
              style={{
                position: 'absolute',
                width: cardWidth,
                height: cardHeight,
                transformOrigin: 'center center',
              }}
              className="rounded-[6px] overflow-hidden bg-[#0A0D11] shadow-[0_4px_16px_rgba(0,0,0,0.25)]"
            >
              <div className="relative w-full h-full">
                <Image
                  src={item.src}
                  alt="Portfolio preview"
                  fill
                  unoptimized
                  sizes="200px"
                  className="object-cover object-center"
                  referrerPolicy="no-referrer"
                />
              </div>
            </motion.div>
          ))}
        </AnimatePresence>
      </div>

      {children}
    </div>
  );
}

