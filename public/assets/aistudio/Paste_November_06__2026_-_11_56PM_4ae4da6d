export interface MouseTrailImage {
  id: number;
  x: number;
  y: number;
  rotation: number;
  src: string;
  alt?: string;
}

interface InlineImageMouseTrailProps {
  images: string[];
  maxCards?: number;
  distanceThreshold?: number;
  cardWidth?: number;
  cardHeight?: number;
  className?: string;
  children?: React.ReactNode;
}

function ImageMouseTrail({
  images,
  maxCards = 8,
  distanceThreshold = 55,
  cardWidth = 180,
  cardHeight = 120,
  className = '',
  children,
}: InlineImageMouseTrailProps) {
  const [trail, setTrail] = useState<MouseTrailImage[]>([]);
  const lastPosRef = useRef<{ x: number; y: number } | null>(null);
  const counterRef = useRef(0);
  const imageIndexRef = useRef(0);
  const containerRef = useRef<HTMLDivElement>(null);
  const idleTimeoutRef = useRef<NodeJS.Timeout | null>(null);

  const handleMouseMove = useCallback(
    (e: React.MouseEvent<HTMLDivElement>) => {
      if (!containerRef.current || images.length === 0) return;

      const targetElement = e.target as HTMLElement | null;
      const isOverInteractive = Boolean(
        targetElement &&
          targetElement.closest('button, a, input, textarea, select, [role="button"]')
      );

      if (isOverInteractive) {
        setTrail([]);
        lastPosRef.current = null;
        if (idleTimeoutRef.current) {
          clearTimeout(idleTimeoutRef.current);
        }
        return;
      }

      const rect = containerRef.current.getBoundingClientRect();
      const currentX = e.clientX - rect.left;
      const currentY = e.clientY - rect.top;

      if (idleTimeoutRef.current) {
        clearTimeout(idleTimeoutRef.current);
      }
      idleTimeoutRef.current = setTimeout(() => {
        setTrail([]);
        lastPosRef.current = null;
      }, 300);

      if (lastPosRef.current) {
        const dx = currentX - lastPosRef.current.x;
        const dy = currentY - lastPosRef.current.y;
        const distance = Math.hypot(dx, dy);

        if (distance < distanceThreshold) {
          return;
        }
      }

      lastPosRef.current = { x: currentX, y: currentY };
      const currentImage = images[imageIndexRef.current % images.length];
      imageIndexRef.current += 1;
      counterRef.current += 1;

      const rotation = Math.random() * 16 - 8;

      const newCard: MouseTrailImage = {
        id: counterRef.current,
        x: currentX,
        y: currentY,
        rotation,
        src: currentImage,
      };

      setTrail((prev) => [...prev.slice(-(maxCards - 1)), newCard]);
    },
    [images, distanceThreshold, maxCards]
  );

  const handleMouseLeave = useCallback(() => {
    lastPosRef.current = null;
    if (idleTimeoutRef.current) {
      clearTimeout(idleTimeoutRef.current);
    }
    setTrail([]);
  }, []);

  useEffect(() => {
    return () => {
      if (idleTimeoutRef.current) {
        clearTimeout(idleTimeoutRef.current);
      }
    };
  }, []);

  return (
    <div
      ref={containerRef}
      onMouseMove={handleMouseMove}
      onMouseLeave={handleMouseLeave}
      className={`relative w-full h-full ${className}`}
    >
      <div className="absolute inset-0 pointer-events-none overflow-hidden z-30">
        <AnimatePresence>
          {trail.map((item) => (
