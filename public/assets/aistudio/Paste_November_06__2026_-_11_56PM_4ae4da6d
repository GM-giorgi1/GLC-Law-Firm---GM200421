export function LoadingScreen() {
  const [isLoading, setIsLoading] = useState<boolean>(true);

  useEffect(() => {
    // Prevent scrolling while loading screen is active
    document.body.style.overflow = 'hidden';

    // Total duration: typing animation completes (~0.75s) + pause (~0.2s) + curtain split (~1.05s)
    const timer = setTimeout(() => {
      setIsLoading(false);
      document.body.style.overflow = '';
    }, 2100);

    return () => {
      clearTimeout(timer);
      document.body.style.overflow = '';
    };
  }, []);

  // Container variants for staggered typing animation of each letter
  const letterContainerVariants: Variants = {
    hidden: { opacity: 1 },
    visible: {
      opacity: 1,
      transition: {
        staggerChildren: 0.045, // fast, crisp typing rhythm
        delayChildren: 0.1,
      },
    },
  };

  const letterVariants: Variants = {
    hidden: {
      opacity: 0,
      y: 14,
      scale: 0.92,
      filter: 'blur(4px)',
    },
    visible: {
      opacity: 1,
      y: 0,
      scale: 1,
      filter: 'blur(0px)',
      transition: {
        duration: 0.35,
        ease: [0.16, 1, 0.3, 1],
      },
    },
  };

  return (
    <AnimatePresence mode="wait">
      {isLoading && (
        <motion.div
          key="loader-container"
          initial={{ opacity: 1 }}
          exit={{
            opacity: 0,
            transition: { duration: 0.35, ease: 'easeInOut' },
          }}
          className="fixed inset-0 z-[99999] w-full h-full overflow-hidden pointer-events-none select-none"
        >
          {/* ================================================================= */}
          {/* BEHIND THE CURTAINS: HEADER BG BACKER IMAGE & HERO PORTRAIT REVEAL */}
          {/* ================================================================= */}
          <div className="absolute inset-0 w-full h-full bg-[#00070B]">
            {/* Background Image replacing orange color gradient */}
            <Image
              src="https://cdn.jiro.build/Backer/All%20Images/header%20bg%20backer.webp"
              alt="Loading Background"
              fill
              priority
              unoptimized
              sizes="100vw"
              className="object-cover object-center"
            />
            {/* High-res Hero Men Cutout matching the header perfectly */}
            <div className="relative w-full h-full flex items-end justify-end">
              <Image
                src="https://cdn.jiro.build/Backer/All%20Images/men%20img.webp"
                alt="Matteo Backer - Portrait Loading Reveal"
                fill
                priority
                unoptimized
                sizes="100vw"
                className="object-cover object-right-bottom sm:object-right md:object-[80%_center] lg:object-right-bottom"
                referrerPolicy="no-referrer"
              />
            </div>
          </div>

          {/* ================================================================= */}
          {/* TOP CURTAIN (Black panel with "MATTEO BACKER" typing animation) */}
          {/* ================================================================= */}
          <motion.div
            initial={{ y: '0%' }}
            animate={{ y: '-100%' }}
            transition={{
              duration: 1.05,
              delay: 0.95, // Starts split right after typing finishes
              ease: [0.76, 0, 0.24, 1], // cinematic smooth shutter split
            }}
            className="absolute top-0 left-0 w-full h-1/2 bg-[#00070B] flex flex-col justify-end items-center pb-2 sm:pb-3 px-4 z-20"
            style={{ backgroundColor: '#00070B' }}
          >
            <motion.h1
              variants={letterContainerVariants}
              initial="hidden"
              animate="visible"
              className="font-big-shoulders font-[900] uppercase text-[#F2ECEC] tracking-tight leading-none text-[32px] sm:text-[46px] md:text-[56px] lg:text-[64px] text-center flex items-center justify-center flex-wrap"
              style={{
                fontFamily: "'Big Shoulders Display', 'Big Shoulders', sans-serif",
                fontWeight: 900,
                lineHeight: '100%',
                color: '#F2ECEC',
              }}
            >
              {LOADING_TITLE_TEXT.split('').map((char, index) => (
                <motion.span
                  key={index}
                  variants={letterVariants}
                  className="inline-block"
                  style={{ whiteSpace: char === ' ' ? 'pre' : 'normal' }}
                >
                  {char}
                </motion.span>
              ))}
            </motion.h1>
          </motion.div>

          {/* ================================================================= */}
          {/* BOTTOM CURTAIN (Black panel with subtitle at top edge) */}
          {/* ================================================================= */}
          <motion.div
            initial={{ y: '0%' }}
            animate={{ y: '100%' }}
            transition={{
              duration: 1.05,
              delay: 0.95, // Starts split right after typing finishes
              ease: [0.76, 0, 0.24, 1], // cinematic smooth shutter split
            }}
            className="absolute bottom-0 left-0 w-full h-1/2 bg-[#00070B] flex flex-col justify-start items-center pt-2 sm:pt-3 px-4 z-20"
            style={{ backgroundColor: '#00070B' }}
          >
            <motion.p
              initial={{ opacity: 0, y: -8, filter: 'blur(4px)' }}
